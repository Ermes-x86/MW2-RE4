+    /// RE4 bridge: sets one weapon's clip and reserve to the host's counts,
+    /// beyond IW4's clip size and max ammo (RE4 capacity upgrades). An offhand
+    /// (grenade) keeps its count in the clip and is given when it is missing.
+    pub fn bridge_set_ammo(&mut self, id: ClientId, weapon: u32, clip: i32, stock: i32, size: i32) -> bool {
+        use crate::script_player::{WeaponList, give_weapon, has_weapon, take_weapon, weapons};
+        let mut frame = self.frame();
+        if frame.player(id).is_none() || frame.combat_facts_for(weapon).is_none() {
+            return false;
+        }
+        let offhand = frame.equipment_facts_for(weapon).filter(|eq| eq.is_offhand());
+        if let Some(eq) = offhand {
+            // One lethal and one tactical, both the host's: any other of the same kind the class gave
+            // (throwing knife, semtex, stun, smoke...) is taken, even when the host has none of its own.
+            let lethal = |class: i32| matches!(class, 1 | 4 | 5);
+            for other in weapons(&frame, id, WeaponList::Offhands) {
+                if other != weapon
+                    && frame
+                        .equipment_facts_for(other)
+                        .is_some_and(|o| o.is_offhand() && lethal(o.offhand_class) == lethal(eq.offhand_class))
+                {
+                    take_weapon(&mut frame, id, other);
+                }
+            }
+        }
+        if !has_weapon(&frame, id, weapon) {
+            if clip <= 0 && stock <= 0 {
+                return true;
+            }
+            if give_weapon(&mut frame, id, weapon, false).is_err() {
+                return false;
+            }
+        }
+        if let Some(eq) = offhand {
+            let lethal = |class: i32| matches!(class, 1 | 4 | 5);
+            if let Some(ps) = frame.player_mut(id) {
+                if lethal(eq.offhand_class) {
+                    ps.offhand_primary = eq.offhand_class;
+                } else {
+                    ps.offhand_secondary = eq.offhand_class;
+                }
+            }
+        } else if size > 0 {
+            crate::world::set_bridge_clip_size(weapon, size);
+        }
+        bridge_ammo(&mut frame, id, weapon, clip, stock);
+        true
+    }
