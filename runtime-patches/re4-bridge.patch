+fn bridge_ammo(frame: &mut FrameWorld, id: ClientId, weapon: u32, clip: i32, stock: i32) {
+    let Some(facts) = frame.combat_facts_for(weapon) else {
+        return;
+    };
+    let offhand = frame.equipment_facts_for(weapon).is_some_and(|eq| eq.is_offhand());
+    let clip = clip.clamp(0, 999);
+    let stock = if offhand { 0 } else { stock.clamp(0, 9999) };
+    let clip_key = weapon_iw4::clip_table_key(facts.clip_index, weapon);
+    let ammo_key = weapon_iw4::ammo_table_key(facts.ammo_index, weapon);
+    if let Some(ps) = frame.player_mut(id) {
+        let _ = weapon_iw4::set_clip_for_hand(&mut ps.ammoclip, clip_key, 0, clip);
+        // an offhand's count is its clip plus its ammo row, so the row is emptied
+        let _ = weapon_iw4::set_ammo_not_in_clip(&mut ps.ammo, ammo_key, stock);
+    }
+    let meta = frame.client_meta_mut(id);
+    meta.set_ammo(weapon, clip, stock);
+    if frame.player(id).is_some_and(|ps| ps.weapon == weapon) {
+        frame.client_meta_mut(id).mirror_held_ammo(weapon);
+    }
+}
