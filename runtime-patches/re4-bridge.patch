+    pub fn bridge_equip(&mut self, id: ClientId, weapon: u32, clip: i32, stock: i32, size: i32) -> bool {
+        use crate::script_player::{WeaponList, give_weapon, has_weapon, switch_to_weapon, take_weapon, weapons};
+        let mut frame = self.frame();
+        if frame.player(id).is_none() || frame.combat_facts_for(weapon).is_none() {
+            return false;
+        }
+        for other in weapons(&frame, id, WeaponList::Primaries) {
+            if other != weapon {
+                take_weapon(&mut frame, id, other);
+            }
+        }
