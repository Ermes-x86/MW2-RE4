+//! MW2-RE4: Leon-style first-person arms (shared state and the paint recipe).
+//!
+//! With `IW4L_RE4_LEON_STYLE` set (the host loads mp_subbase), the map's two arms models stand for Leon's two
+//! looks in RE4: the axis' thick arctic sleeves are Leon in his leather jacket, the allies' slim SEAL wetsuit
+//! arms are Leon without it (short dark sleeves, bare forearms). Both keep MW2's mesh and animation; their
+//! images are repainted (render_frontend `re4_leon_style`) by which bones each texel's triangle hangs on: upper
+//! arm, forearm, hand (wrist, palm, first finger joints: Leon's fingerless gloves) or finger tips. The host reports the look RE4 shows (`set_look`) and the
+//! first-person view takes that side's arms (`arms_axis`).
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use crate::FpvSkel;
+
+const VAR: &str = "IW4L_RE4_LEON_STYLE";
+
+/// What RE4 shows: 0 not known yet, 1 jacket, 2 no jacket.
+static LOOK: AtomicU8 = AtomicU8::new(0);
+
+pub fn enabled() -> bool {
+    std::env::var_os(VAR).is_some_and(|v| v != "0")
+}
+
+pub fn set_look(look: u32) {
+    let look = match look {
+        1 | 2 => look as u8,
+        _ => 0,
+    };
+    LOOK.store(look, Ordering::Relaxed);
+}
+
+/// Whether the no-jacket look is used when RE4 reports it. Off for now: MW2 has no bare-forearm arms, and the
+/// SEAL sleeve painted as skin did not look right, so Leon keeps the jacket arms all game.
+pub const BARE_LOOK: bool = false;
+
+/// The side whose arms the first-person view shows: jacket = axis (arctic), no jacket = allies (SEAL wetsuit).
+/// None when the style is off (the game's own team choice stands).
+pub fn arms_axis() -> Option<bool> {
+    if !enabled() {
+        return None;
+    }
+    match LOOK.load(Ordering::Relaxed) {
+        2 if BARE_LOOK => Some(false),
+        _ => Some(true),
+    }
+}
+
+/// How a texel is painted.
+pub const LABEL_NONE: u8 = 0;
+pub const LABEL_ARM: u8 = 1;
+pub const LABEL_HAND: u8 = 2;
+pub const LABEL_FINGERTIP: u8 = 3;
+pub const LABEL_UPPER: u8 = 4;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Look {
+    /// leather sleeves, black fingerless gloves
+    Jacket,
+    /// short dark sleeves, bare forearms, black fingerless gloves
+    Bare,
+}
+
+/// Which look an arms model stands for: the slim SEAL wetsuit arms are the bare ones.
+pub fn look_of_model(name: &str) -> Look {
+    if name.to_ascii_lowercase().contains("udt") { Look::Bare } else { Look::Jacket }
+}
+
+fn bone_label(name: &str) -> u8 {
+    let n = name.to_ascii_lowercase();
+    let finger = ["j_thumb_", "j_index_", "j_mid_", "j_ring_", "j_pinky_"].iter().find(|p| n.starts_with(**p));
+    if let Some(prefix) = finger {
+        // j_index_le_1 is the first joint; Leon's gloves stop past it (the thumb's first joint sits in the palm)
+        let joint = n.rsplit('_').next().and_then(|d| d.parse::<u32>().ok()).unwrap_or(1);
+        let covered = if *prefix == "j_thumb_" { 2 } else { 1 };
+        return if joint <= covered { LABEL_HAND } else { LABEL_FINGERTIP };
+    }
+    if (n.starts_with("j_wrist_") && !n.starts_with("j_wristtwist")) || n.starts_with("j_webbing") || n.starts_with("j_palm")
+    {
+        return LABEL_HAND;
+    }
+    if n.starts_with("j_shoulder") || n.starts_with("j_clavicle") {
+        return LABEL_UPPER;
+    }
+    LABEL_ARM
+}
+
+fn vertex_weights(skel: &FpvSkel, v: usize) -> [(usize, f32); 4] {
+    let mut out = [(0usize, 0.0f32); 4];
+    let Some(skin) = skel.vert_skin.get(v) else { return out };
+    let mut extras = 0.0;
+    for extra in 1..4 {
+        if skin.has_extra_weight(extra) {
+            let w = f32::from(skin.extra_weight(extra)) / 65536.0;
+            out[extra] = (usize::from(skin.bones[extra]), w);
+            extras += w;
+        }
+    }
+    out[0] = (usize::from(skin.bones[0]), if skin.primary_is_zero() { 0.0 } else { 1.0 - extras });
+    out
+}
+
+/// A `width` x `height` label map of the texels `skel`'s surfaces `surfaces` cover (LABEL_*), grown a few texels
+/// past the UV islands' edges so filtering at seams finds the same paint.
+pub fn uv_labels(skel: &FpvSkel, surfaces: &[usize], width: u32, height: u32) -> Vec<u8> {
+    let (w, h) = (width as usize, height as usize);
+    let uvs: Vec<[f32; 2]> = skel.uvs().collect();
+    let bone_labels: Vec<u8> = skel.bone_names.iter().map(|n| bone_label(n)).collect();
+    // per vertex: share of weight on arm / hand / finger tip / upper arm
+    let shares: Vec<[f32; 4]> = (0..skel.positions.len())
+        .map(|v| {
+            let mut s = [0.0f32; 4];
+            for (bone, weight) in vertex_weights(skel, v) {
+                if weight > 0.0 {
+                    let label = bone_labels.get(bone).copied().unwrap_or(LABEL_ARM);
+                    s[usize::from(label - 1)] += weight;
+                }
+            }
+            s
+        })
+        .collect();
+    let mut labels = vec![LABEL_NONE; w * h];
+    for &s in surfaces {
+        let Some(&(i0, n)) = skel.surface_index_ranges.get(s) else { continue };
+        let Some(tris) = skel.indices.get(i0..i0 + n) else { continue };
+        for t in tris.chunks_exact(3) {
+            let (a, b, c) = (t[0] as usize, t[1] as usize, t[2] as usize);
+            let (Some(ua), Some(ub), Some(uc)) = (uvs.get(a), uvs.get(b), uvs.get(c)) else { continue };
+            let p = |uv: &[f32; 2]| [uv[0] * width as f32, uv[1] * height as f32];
+            let (pa, pb, pc) = (p(ua), p(ub), p(uc));
+            let area = (pb[0] - pa[0]) * (pc[1] - pa[1]) - (pc[0] - pa[0]) * (pb[1] - pa[1]);
+            if area.abs() < 1e-6 {
+                continue;
+            }
+            let min_x = pa[0].min(pb[0]).min(pc[0]).floor() as i64;
+            let max_x = pa[0].max(pb[0]).max(pc[0]).ceil() as i64;
+            let min_y = pa[1].min(pb[1]).min(pc[1]).floor() as i64;
+            let max_y = pa[1].max(pb[1]).max(pc[1]).ceil() as i64;
+            for y in min_y..=max_y {
+                for x in min_x..=max_x {
+                    let q = [x as f32 + 0.5, y as f32 + 0.5];
+                    let wa = ((pb[0] - q[0]) * (pc[1] - q[1]) - (pc[0] - q[0]) * (pb[1] - q[1])) / area;
+                    let wb = ((pc[0] - q[0]) * (pa[1] - q[1]) - (pa[0] - q[0]) * (pc[1] - q[1])) / area;
+                    let wc = 1.0 - wa - wb;
+                    if wa < -0.01 || wb < -0.01 || wc < -0.01 {
+                        continue;
+                    }
+                    let mut best = 0;
+                    let mut share = [0.0f32; 4];
+                    for k in 0..4 {
+                        share[k] = shares[a][k] * wa + shares[b][k] * wb + shares[c][k] * wc;
+                        if share[k] > share[best] {
+                            best = k;
+                        }
+                    }
+                    let tx = x.rem_euclid(w as i64) as usize;
+                    let ty = y.rem_euclid(h as i64) as usize;
+                    labels[ty * w + tx] = best as u8 + 1;
+                }
+            }
+        }
+    }
+    // grow islands by a few texels (UV padding)
+    let grow = (width.max(height) / 256).max(2) as usize;
+    for _ in 0..grow {
+        let src = labels.clone();
+        for y in 0..h {
+            for x in 0..w {
+                if src[y * w + x] != LABEL_NONE {
+                    continue;
+                }
+                let near = [(x.wrapping_sub(1), y), (x + 1, y), (x, y.wrapping_sub(1)), (x, y + 1)]
+                    .into_iter()
+                    .filter(|&(nx, ny)| nx < w && ny < h)
+                    .map(|(nx, ny)| src[ny * w + nx])
+                    .find(|&l| l != LABEL_NONE);
+                if let Some(l) = near {
+                    labels[y * w + x] = l;
+                }
+            }
+        }
+    }
+    labels
+}
+
+fn luma(p: &[u8]) -> f32 {
+    (0.299 * f32::from(p[0]) + 0.587 * f32::from(p[1]) + 0.114 * f32::from(p[2])) / 255.0
+}
+
+/// Box blur of a single channel, radius `r`, wrapping.
+fn blur(src: &[f32], w: usize, h: usize, r: usize) -> Vec<f32> {
+    let mut tmp = vec![0.0f32; w * h];
+    let span = (2 * r + 1) as f32;
+    for y in 0..h {
+        let row = &src[y * w..(y + 1) * w];
+        let mut sum: f32 = (0..=2 * r).map(|i| row[(i + w - r % w) % w]).sum();
+        for x in 0..w {
+            tmp[y * w + x] = sum / span;
+            sum += row[(x + r + 1) % w] - row[(x + w - r % w) % w];
+        }
+    }
+    let mut out = vec![0.0f32; w * h];
+    for x in 0..w {
+        let mut sum: f32 = (0..=2 * r).map(|i| tmp[((i + h - r % h) % h) * w + x]).sum();
+        for y in 0..h {
+            out[y * w + x] = sum / span;
+            sum += tmp[((y + r + 1) % h) * w + x] - tmp[((y + h - r % h) % h) * w + x];
+        }
+    }
+    out
+}
+
+fn srgb_mul(base: [f32; 3], k: f32) -> [u8; 3] {
+    base.map(|c| (c * k).clamp(0.0, 255.0) as u8)
+}
+
+/// The surfaces Leon's arms are painted with. Colours and grain follow the user's own hand-painted arms
+/// (measured from their painting: the mean colour of each part and how much it varies), so every player gets
+/// that look without any image being shipped.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Surface {
+    Leather,
+    Glove,
+    Shirt,
+    Skin,
+}
+
+impl Surface {
+    /// sRGB base colour, share of MW2's shading detail kept, mottle strength
+    fn recipe(self) -> ([f32; 3], f32, f32) {
+        match self {
+            Surface::Leather => ([92.0, 76.0, 57.0], 0.6, 0.85),
+            Surface::Glove => ([7.0, 7.0, 7.0], 0.6, 0.08),
+            Surface::Shirt => ([29.0, 30.0, 29.0], 0.4, 0.06),
+            Surface::Skin => ([185.0, 153.0, 124.0], 0.4, 0.14),
+        }
+    }
+}
+
+/// What `label` becomes in `look` (`glove`: the image is the gloves', where the arm texels are the glove's cuff).
+/// None = MW2's texel stays.
+fn surface_of(look: Look, glove: bool, label: u8) -> Option<Surface> {
+    match (look, label) {
+        (_, LABEL_HAND) => Some(Surface::Glove),
+        (_, LABEL_FINGERTIP) => Some(Surface::Skin),
+        (_, LABEL_ARM | LABEL_UPPER) if glove => Some(Surface::Glove),
+        (Look::Jacket, LABEL_ARM | LABEL_UPPER) => Some(Surface::Leather),
+        (Look::Bare, LABEL_UPPER) => Some(Surface::Shirt),
+        (Look::Bare, LABEL_ARM) => Some(Surface::Skin),
+        _ => None,
+    }
+}
+
+/// Cloud-like fractal noise in about 0..1; `period` is the largest feature in texels.
+fn clouds(x: f32, y: f32, period: f32, seed: u32) -> f32 {
+    let (mut sum, mut amp, mut norm, mut p) = (0.0, 1.0, 0.0, period);
+    for octave in 0..4 {
+        sum += amp * value_noise(x / p, y / p, seed + octave);
+        norm += amp;
+        amp *= 0.5;
+        p *= 0.5;
+    }
+    sum / norm
+}
+
+/// Hand-painted details of the jacket sleeve image (`arctic_b_sleeve_col`), in texels of a 1024 x 1024 image:
+/// three stitched seams and a fur strip along the cuff.
+const JACKET_SLEEVE_IMAGE: &str = "arctic_b_sleeve_col";
+const SEAMS: [[f32; 4]; 3] = [[7.0, 177.0, 671.0, 306.0], [27.0, 595.0, 560.0, 551.0], [126.0, 133.0, 163.0, 618.0]];
+/// fur strip: top edge from (x0, y0) to (x1, y1), then `FUR_DEPTH` texels down
+const FUR_TOP: [f32; 4] = [25.0, 641.0, 522.0, 602.0];
+const FUR_DEPTH: f32 = 36.0;
+
+fn mix(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {
+    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]
+}
+
+/// The jacket sleeve's details at texel (x, y) in 1024-space, if any: fur, the dark edge above it, or a seam.
+fn jacket_detail(x: f32, y: f32) -> Option<[f32; 3]> {
+    let [x0, y0, x1, y1] = FUR_TOP;
+    if (x0..=x1).contains(&x) {
+        let base_top = y0 + (y1 - y0) * (x - x0) / (x1 - x0);
+        let top = base_top + 4.0 * (clouds(x, 0.5, 12.0, 21) - 0.5);
+        if y >= top && y <= base_top + FUR_DEPTH {
+            let t = clouds(x, y, 10.0, 22);
+            return Some(mix([150.0, 128.0, 88.0], [214.0, 190.0, 140.0], ((t - 0.5) * 2.2 + 0.5).clamp(0.0, 1.0)));
+        }
+        if y >= top - 2.5 && y < top {
+            return Some([48.0, 34.0, 24.0]);
+        }
+    }
+    for [ax, ay, bx, by] in SEAMS {
+        let (dx, dy) = (bx - ax, by - ay);
+        let len2 = dx * dx + dy * dy;
+        let t = (((x - ax) * dx + (y - ay) * dy) / len2).clamp(0.0, 1.0);
+        let (px, py) = (ax + dx * t, ay + dy * t);
+        let d = ((x - px).powi(2) + (y - py).powi(2)).sqrt();
+        if d <= 2.6 {
+            let along = t * len2.sqrt();
+            let streak = value_noise(along / 6.0, d, 23);
+            let core = mix([96.0, 56.0, 36.0], [136.0, 82.0, 52.0], streak);
+            return Some(if d > 1.8 { mix(core, [62.0, 38.0, 26.0], 0.7) } else { core });
+        }
+    }
+    None
+}
+
+/// Paint the colour map `rgba` (top level, `width` x `height`, image `image`) by `labels` for `look`. Each part
+/// gets its colour with a cloudy mottle and a little of MW2's own shading detail (its luminance minus a blur,
+/// clamped so camouflage blotches do not come through); the jacket sleeve also gets its seams and fur strip.
+pub fn paint(look: Look, glove: bool, image: &str, labels: &[u8], width: u32, height: u32, rgba: &mut [u8]) {
+    let (w, h) = (width as usize, height as usize);
+    if labels.len() != w * h || rgba.len() != w * h * 4 {
+        return;
+    }
+    let l: Vec<f32> = rgba.chunks_exact(4).map(luma).collect();
+    let wide = blur(&l, w, h, (w.max(h) / 128).max(2));
+    // design coordinates are texels of a 1024 x 1024 image
+    let (sx, sy) = (1024.0 / width as f32, 1024.0 / height as f32);
+    let jacket_sleeve = look == Look::Jacket && image.eq_ignore_ascii_case(JACKET_SLEEVE_IMAGE);
+    for i in 0..w * h {
+        let Some(surface) = surface_of(look, glove, labels[i]) else { continue };
+        let (x, y) = ((i % w) as f32 * sx, (i / w) as f32 * sy);
+        let (mut base, gain, mottle) = surface.recipe();
+        let detail = (l[i] - wide[i]).clamp(-0.07, 0.07);
+        let mut k = 1.0 + gain * detail;
+        match surface {
+            Surface::Leather => {
+                k *= 1.0 + mottle * (clouds(x, y, 22.0, 1) - 0.5) + 0.12 * (value_noise(x / 1.5, y / 1.5, 5) - 0.5)
+            }
+            Surface::Skin => {
+                k *= 1.0 + mottle * (clouds(x, y, 90.0, 2) - 0.5);
+                base[0] *= 1.0 + 0.05 * (value_noise(x / 170.0, y / 170.0, 3) - 0.5);
+            }
+            _ => k *= 1.0 + mottle * (clouds(x, y, 24.0, 4) - 0.5),
+        }
+        let mut color = base.map(|c| c * k);
+        if jacket_sleeve && surface == Surface::Leather {
+            if let Some(painted) = jacket_detail(x, y) {
+                color = painted.map(|c| c * (1.0 + gain * detail));
+            }
+        }
+        for c in 0..3 {
+            rgba[i * 4 + c] = color[c].clamp(0.0, 255.0) as u8;
+        }
+    }
+}
+
+fn hash(x: i64, y: i64, seed: u32) -> f32 {
+    let mut n = (x as u32).wrapping_mul(0x27d4_eb2d) ^ (y as u32).wrapping_mul(0x1656_67b1) ^ seed.wrapping_mul(0x9e37_79b9);
+    n ^= n >> 15;
+    n = n.wrapping_mul(0x85eb_ca6b);
+    n ^= n >> 13;
+    (n & 0xffff) as f32 / 65535.0
+}
+
+/// Smooth value noise in 0..1.
+fn value_noise(x: f32, y: f32, seed: u32) -> f32 {
+    let (x0, y0) = (x.floor(), y.floor());
+    let (fx, fy) = (x - x0, y - y0);
+    let (sx, sy) = (fx * fx * (3.0 - 2.0 * fx), fy * fy * (3.0 - 2.0 * fy));
+    let (ix, iy) = (x0 as i64, y0 as i64);
+    let top = hash(ix, iy, seed) * (1.0 - sx) + hash(ix + 1, iy, seed) * sx;
+    let bottom = hash(ix, iy + 1, seed) * (1.0 - sx) + hash(ix + 1, iy + 1, seed) * sx;
+    top * (1.0 - sy) + bottom * sy
+}
+
+/// Smooth the normal map where skin now shows (bare forearms, finger tips): cloth wrinkles fade into a wide blur
+/// of themselves (a quarter kept), whatever the map's channel layout.
+pub fn smooth_normals(look: Look, glove: bool, labels: &[u8], width: u32, height: u32, rgba: &mut [u8]) {
+    let (w, h) = (width as usize, height as usize);
+    if labels.len() != w * h || rgba.len() != w * h * 4 {
+        return;
+    }
+    let skin = |label: u8| surface_of(look, glove, label) == Some(Surface::Skin);
+    if !labels.iter().any(|&l| skin(l)) {
+        return;
+    }
+    let radius = (w.max(h) / 32).max(2);
+    let channels: Vec<Vec<f32>> = (0..4)
+        .map(|c| blur(&rgba.iter().skip(c).step_by(4).map(|&v| f32::from(v)).collect::<Vec<_>>(), w, h, radius))
+        .collect();
+    for i in 0..w * h {
+        if skin(labels[i]) {
+            for c in 0..4 {
+                let kept = f32::from(rgba[i * 4 + c]) * 0.25 + channels[c][i] * 0.75;
+                rgba[i * 4 + c] = kept.round().clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+}
+
+/// Local painted-jacket finish. Operates at load time; the player's PNGs remain intact.
+/// Neutral black gloves, warmer leather, and restrained grain; preserve skin and alpha.
+pub fn finish_painted(look: Look, glove: bool, labels: &[u8], width: u32, height: u32, rgba: &mut [u8]) {
+    let (w, h) = (width as usize, height as usize);
+    if labels.len() != w * h || rgba.len() != w * h * 4 { return; }
+    for i in 0..w * h {
+        let label = labels[i];
+        let p = &mut rgba[i * 4..i * 4 + 4];
+        if label == LABEL_FINGERTIP || label == LABEL_NONE { continue; }
+        if glove {
+            // Cap the albedo rather than multiplying repeatedly: truly black, with detail.
+            let l = 0.2126 * p[0] as f32 + 0.7152 * p[1] as f32 + 0.0722 * p[2] as f32;
+            let black = (3.0 + l * 0.30).clamp(3.0, 12.0).round() as u8;
+            p[..3].fill(black);
+        } else if look == Look::Jacket && matches!(label, LABEL_ARM | LABEL_UPPER) {
+            // Preserve light shearling and seams. Remove the old olive cast from leather.
+            let l = 0.2126 * p[0] as f32 + 0.7152 * p[1] as f32 + 0.0722 * p[2] as f32;
+            if l < 112.0 {
+                let x = (i % w) as f32 * 1024.0 / width as f32;
+                let y = (i / w) as f32 * 1024.0 / height as f32;
+                let grain = (value_noise(x / 1.7, y / 1.7, 53) - 0.5) * 1.8;
+                let tone = 60.0 + (l - 63.0) * 0.72;
+                // a warm red-brown (the user's "more brown"); MW2's lighting greys it a little
+                for (c, ratio) in [1.42, 0.88, 0.46].iter().enumerate() {
+                    p[c] = (tone * ratio + grain).round().clamp(0.0, 255.0) as u8;
+                }
+            }
+        }
+    }
+}
+
+/// Reduce fine fabric embossing while retaining MW2's broad animated sleeve folds.
+pub fn soften_jacket_normals(look: Look, glove: bool, labels: &[u8], width: u32, height: u32, rgba: &mut [u8]) {
+    let (w, h) = (width as usize, height as usize);
+    if look != Look::Jacket || glove || labels.len() != w*h || rgba.len() != w*h*4 { return; }
+    let radius = (w.max(h) / 256).max(2);
+    let channels: Vec<Vec<f32>> = (0..4).map(|c| blur(&rgba.iter().skip(c).step_by(4).map(|&v| v as f32).collect::<Vec<_>>(), w, h, radius)).collect();
+    for i in 0..w*h {
+        if matches!(labels[i], LABEL_ARM | LABEL_UPPER) {
+            for c in 0..4 {
+                rgba[i*4+c] = (rgba[i*4+c] as f32 * 0.30 + channels[c][i] * 0.70).round().clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+}
+/// Gloves: little shine, so they read black rather than dark grey under MW2's lights.
+/// The jacket's leather: little shine, so it reads as solid matte brown under MW2's lights, not glossy or washed out.
+pub fn jacket_specular(look: Look, glove: bool, labels: &[u8], rgba: &mut [u8]) {
+    if look != Look::Jacket || glove || rgba.len() != labels.len() * 4 { return; }
+    for (pixel, &label) in rgba.chunks_exact_mut(4).zip(labels) {
+        if matches!(label, LABEL_ARM | LABEL_UPPER) {
+            for c in &mut pixel[..3] { *c = (f32::from(*c) * 0.35).round() as u8; }
+        }
+    }
+}
+
+pub fn glove_specular(glove: bool, labels: &[u8], rgba: &mut [u8]) {
+    if !glove || rgba.len() != labels.len() * 4 { return; }
+    for (pixel, &label) in rgba.chunks_exact_mut(4).zip(labels) {
+        if label != LABEL_NONE && label != LABEL_FINGERTIP {
+            for c in &mut pixel[..3] { *c = (f32::from(*c) * 0.25).round() as u8; }
+        }
+    }
+}
