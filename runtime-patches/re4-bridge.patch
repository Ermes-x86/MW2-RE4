+//! MW2-RE4: Leon-style first-person arms. MW2's own arms models are kept (their fit and animation are MW2's);
+//! only their colour maps are repainted from the player's own MW2 images while the map's images are handed to
+//! the GPU (`asset_model::re4_leon_style`: the jacket arms get Leon's brown leather, the bare arms his short
+//! dark sleeves and skin with the cloth wrinkles smoothed out of their normal map, both black fingerless gloves). Nothing is shipped: the recipe is code, the pixels come from the
+//! player's MW2.
+//!
+//! `IW4L_RE4_LEON_PAINT=<folder>`: a `<image>.png` there (same size as MW2's image) is used instead of the
+//! automatic paint, for players who paint their own. `IW4L_DUMP_FPV=<folder>`: every arms colour map is saved
+//! there as `<image>.png` (MW2's original, to paint over), `<image>_leon.png` and `<image>_labels.png`.
+use std::collections::HashMap;
+use std::path::Path;
+use std::sync::Arc;
+
+use asset_model::re4_leon_style::{self as style, Look};
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureFormat};
+
+use super::world::WorldScene;
+
+/// Which arms models' surfaces use each material: material asset id -> [(mesh index, surfaces, look)].
+type Uses = HashMap<usize, Vec<(usize, Vec<usize>, Look)>>;
+
+fn arms_material_uses(fpv: &assets::PreparedFpvMeshes) -> Uses {
+    let mut uses: Uses = HashMap::new();
+    for i in 0..fpv.0.len() {
+        let Some(mesh) = fpv.0.get_at(i) else { continue };
+        let name = mesh.skel.name.to_ascii_lowercase();
+        if !asset_model::is_arms_model(&name) {
+            continue;
+        }
+        let look = style::look_of_model(&name);
+        if look == Look::Bare && !style::BARE_LOOK {
+            continue;
+        }
+        let mut by_material: HashMap<usize, Vec<usize>> = HashMap::new();
+        for (s, edge) in mesh.material_edges.iter().enumerate() {
+            if let Some(material) = edge.bound_index() {
+                by_material.entry(material).or_default().push(s);
+            }
+        }
+        for (material, surfaces) in by_material {
+            uses.entry(material).or_default().push((i, surfaces, look));
+        }
+    }
+    uses
+}
+
+fn file_name(image: &str) -> String {
+    image.replace(['/', '\\', ':', '$', '*', '?', '"', '<', '>', '|'], "_")
+}
+
+fn write_png(path: &Path, width: u32, height: u32, rgba: &[u8]) {
+    let Ok(file) = std::fs::File::create(path) else { return };
+    let mut encoder = png::Encoder::new(std::io::BufWriter::new(file), width, height);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder.set_depth(png::BitDepth::Eight);
+    if let Ok(mut writer) = encoder.write_header() {
+        let _ = writer.write_image_data(rgba);
+    }
+}
+
+/// The player's own painting of `image`, if there is one of the right size (RGBA or RGB, 8 bit).
+fn read_png(path: &Path, width: u32, height: u32) -> Option<Vec<u8>> {
+    let file = std::fs::File::open(path).ok()?;
+    let mut decoder = png::Decoder::new(std::io::BufReader::new(file));
+    decoder.set_transformations(png::Transformations::normalize_to_color8());
+    let mut reader = decoder.read_info().ok()?;
+    let mut buffer = vec![0; reader.output_buffer_size()?];
+    let info = reader.next_frame(&mut buffer).ok()?;
+    if info.width != width || info.height != height {
+        diag::warn!(
+            World,
+            "RE4 Leon style: {} is {}x{}, MW2's image is {width}x{height}: not used",
+            path.display(),
+            info.width,
+            info.height
+        );
+        return None;
+    }
+    let pixels = &buffer[..info.buffer_size()];
+    match info.color_type {
+        png::ColorType::Rgba => Some(pixels.to_vec()),
+        png::ColorType::Rgb => Some(pixels.chunks_exact(3).flat_map(|p| [p[0], p[1], p[2], 255]).collect()),
+        png::ColorType::GrayscaleAlpha => Some(pixels.chunks_exact(2).flat_map(|p| [p[0], p[0], p[0], p[1]]).collect()),
+        png::ColorType::Grayscale => Some(pixels.iter().flat_map(|&g| [g, g, g, 255]).collect()),
+        _ => None,
+    }
+}
+
+/// Repaint (and/or dump) the arms colour maps among `images`, indexed like the catalog's image bindings.
+/// `variants`/`common` are cleared for repainted slots so no shared copy of MW2's original is reused.
+pub(crate) fn repaint(
+    scene: &WorldScene,
+    fpv: &assets::PreparedFpvMeshes,
+    images: &mut [Option<Arc<Image>>],
+    variants: &mut [Option<asset_material::ImageVariantId>],
+    common: &mut [bool],
+) {
+    let dump_to = std::env::var_os("IW4L_DUMP_FPV").map(std::path::PathBuf::from);
+    let own = std::env::var_os("IW4L_RE4_LEON_PAINT").map(std::path::PathBuf::from);
+    let enabled = style::enabled();
+    if dump_to.is_none() && !enabled {
+        return;
+    }
+    if let Some(folder) = dump_to.as_deref() {
+        let _ = std::fs::create_dir_all(folder);
+    }
+    let uses = arms_material_uses(fpv);
+    let mut done = Vec::new();
+    for material in &scene.runtime_material_catalog.parts().materials {
+        let Some(users) = uses.get(&(material.asset_id.0 as usize)) else { continue };
+        for (_, texture) in material.textures.iter() {
+            let Some(binding) = texture else { continue };
+            let color = binding.semantic == asset_material::TS_COLOR_MAP;
+            let specular = binding.semantic == asset_material::TS_SPECULAR_MAP;
+            if !color && !specular && binding.semantic != asset_material::TS_NORMAL_MAP {
+                continue;
+            }
+            let slot = binding.image.0 as usize;
+            let Some(Some(image)) = images.get(slot) else { continue };
+            let name = scene.exact_material_names.get(slot).cloned().unwrap_or_else(|| format!("slot{slot}"));
+            let file = file_name(&name);
+            let (width, height, mut rgba) = match asset_material::decoded_image_top_level_rgba8(image) {
+                Ok(decoded) => decoded,
+                Err(error) => {
+                    diag::warn!(World, "RE4 Leon style: `{name}` ({}) not readable: {error}", material.name);
+                    continue;
+                }
+            };
+            // labels from every arms model that uses this image (first one decides the look)
+            let mut labels = vec![style::LABEL_NONE; (width * height) as usize];
+            let look = users[0].2;
+            let glove = material.name.to_ascii_lowercase().contains("glove");
+            if glove && enabled {
+                // MW2's own gloves, untouched: dark grey with full fingers and their stitching (the repainted
+                // near-black glove and skin fingertips did not look right)
+                continue;
+            }
+            for (mesh, surfaces, _) in users {
+                let Some(entry) = fpv.0.get_at(*mesh) else { continue };
+                let more = style::uv_labels(&entry.skel, surfaces, width, height);
+                for (dst, src) in labels.iter_mut().zip(more) {
+                    if *dst == style::LABEL_NONE {
+                        *dst = src;
+                    }
+                }
+            }
+            if !color {
+                if !enabled {
+                    continue;
+                }
+                if specular {
+                    style::jacket_specular(look, glove, &labels, &mut rgba);
+                } else {
+                    style::smooth_normals(look, glove, &labels, width, height, &mut rgba);
+                    style::soften_jacket_normals(look, glove, &labels, width, height, &mut rgba);
+                }
+            } else if let Some(folder) = dump_to.as_deref() {
+                write_png(&folder.join(format!("{file}.png")), width, height, &rgba);
+                let shown: Vec<u8> = labels
+                    .iter()
+                    .flat_map(|&l| match l {
+                        style::LABEL_ARM => [200, 120, 60, 255],
+                        style::LABEL_HAND => [60, 60, 220, 255],
+                        style::LABEL_FINGERTIP => [230, 200, 60, 255],
+                        style::LABEL_UPPER => [90, 200, 110, 255],
+                        _ => [0, 0, 0, 255],
+                    })
+                    .collect();
+                write_png(&folder.join(format!("{file}_labels.png")), width, height, &shown);
+            }
+            if !enabled {
+                continue;
+            }
+            let painted_by_player = own
+                .as_deref()
+                .filter(|_| color)
+                .and_then(|folder| read_png(&folder.join(format!("{file}.png")), width, height));
+            let source = if !color {
+                if specular { "specular softened" } else { "normals smoothed" }
+            } else if let Some(pixels) = painted_by_player {
+                rgba = pixels;
+                "player's own"
+            } else {
+                style::paint(look, glove, &name, &labels, width, height, &mut rgba);
+                "automatic"
+            };
+            if color {
+                style::finish_painted(look, glove, &labels, width, height, &mut rgba);
+            }
+            if let (true, Some(folder)) = (color, dump_to.as_deref()) {
+                write_png(&folder.join(format!("{file}_leon.png")), width, height, &rgba);
+            }
+            let srgb = image.texture_descriptor.format.is_srgb();
+            let mut repainted = (**image).clone();
+            let (data, levels) = with_mips(width, height, rgba);
+            repainted.texture_descriptor.format =
+                if srgb { TextureFormat::Rgba8UnormSrgb } else { TextureFormat::Rgba8Unorm };
+            repainted.texture_descriptor.size = Extent3d { width, height, depth_or_array_layers: 1 };
+            repainted.texture_descriptor.mip_level_count = levels;
+            repainted.data = Some(data);
+            images[slot] = Some(Arc::new(repainted));
+            if let Some(variant) = variants.get_mut(slot) {
+                *variant = None;
+            }
+            if let Some(flag) = common.get_mut(slot) {
+                *flag = false;
+            }
+            done.push(format!("{name} ({}, {look:?}, {source})", material.name));
+        }
+    }
+    if enabled {
+        diag::info!(World, "RE4 Leon style: repainted {} arms images: {}", done.len(), done.join(", "));
+    }
+}
+
+/// Top level plus a box-filtered mip chain, as one buffer (mip 0 first).
+fn with_mips(width: u32, height: u32, top: Vec<u8>) -> (Vec<u8>, u32) {
+    let mut data = top.clone();
+    let (mut w, mut h, mut level) = (width as usize, height as usize, top);
+    let mut levels = 1;
+    while w > 1 || h > 1 {
+        let (nw, nh) = ((w / 2).max(1), (h / 2).max(1));
+        let mut next = vec![0u8; nw * nh * 4];
+        for y in 0..nh {
+            for x in 0..nw {
+                for c in 0..4 {
+                    let mut sum = 0u32;
+                    for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                        let sx = (x * 2 + dx).min(w - 1);
+                        let sy = (y * 2 + dy).min(h - 1);
+                        sum += u32::from(level[(sy * w + sx) * 4 + c]);
+                    }
+                    next[(y * nw + x) * 4 + c] = (sum / 4) as u8;
+                }
+            }
+        }
+        data.extend_from_slice(&next);
+        (w, h, level) = (nw, nh, next);
+        levels += 1;
+    }
+    (data, levels)
+}
