+/// RE4 bridge: the clip size of the host's equipped gun (its capacity upgrade), as `weapon << 32 | size`;
+/// 0 = none. Process-wide so the authority and the client prediction reload alike.
+static BRIDGE_CLIP_SIZE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// RE4 bridge: RE4's firing speed / reload speed upgrades of the host's equipped gun (the clip-size gun above),
+/// as time factors in thousandths, `fire | reload << 16`; 0 = unchanged.
+static BRIDGE_TIMING: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+pub fn set_bridge_timing(packed: u32) {
+    BRIDGE_TIMING.store(packed, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// (fire, reload) time factors of the bridge's equipped gun; 1.0 = unchanged.
+pub fn bridge_timing() -> (f32, f32) {
+    let packed = BRIDGE_TIMING.load(std::sync::atomic::Ordering::Relaxed);
+    let factor = |v: u32| if v == 0 { 1.0 } else { (v as f32 / 1000.0).clamp(0.2, 1.0) };
+    (factor(packed & 0xffff), factor(packed >> 16))
+}
+
+pub fn set_bridge_clip_size(weapon: u32, size: i32) {
+    let value = if size > 0 { (u64::from(weapon) << 32) | u64::from(size as u32) } else { 0 };
+    BRIDGE_CLIP_SIZE.store(value, std::sync::atomic::Ordering::Relaxed);
+}
